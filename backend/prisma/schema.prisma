datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client { 
  provider = "prisma-client-js"
}

enum MessageRole { 
  USER 
  AI
  //just in case
  SYSTEM
}

model User { 
//i wanted to keep track of something like ObjectId or _id, on mongodb atlas and similar
//
    id String @id @default(uuid()) @db.Uuid
    name String 
    email String @unique
    password String 
    // keep track of put requests
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    chats     Chat[]
}

model Message{ 
    id String @id @default(uuid()) @db.Uuid
    content String 
    createdAt DateTime @default(now())
    chatId    String      @db.Uuid

    // keep track of who sent it 
    role MessageRole

    chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)

    @@index([chatId])
}

model Chat {
  id        String   @id @default(uuid()) @db.Uuid
  title     String?  // optional title for the chat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @db.Uuid
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  
  @@index([userId])
}

